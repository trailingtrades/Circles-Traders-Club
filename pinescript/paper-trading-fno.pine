// ============================================================================
//  ⭕ CTC PAPER TRADE PRO — Option-Buying Ecosystem for Indian F&O
// ============================================================================
//  PHASES
//   1 ✅ Manual paper journal (P&L, days, reason)
//   2 ✅ Auto engine — chart-following symbol, auto lot size, futures price,
//        click-to-trade (Entry/Stop/Target), R:R, days held, journal book
//   3 ✅ OPTION ENGINE — live option premiums fetched from TradingView by
//        expiry+strike+CE/PE (no manual price updates), IV solved from the
//        live premium (Newton-Raphson on Black-Scholes), Delta/Gamma/Theta/
//        Vega, breakevens, single-leg CE/PE buying + LONG STRADDLE/STRANGLE
//   4 ✅ OPPORTUNITY SCANNER — buy-side signals (BUY CE momentum, BUY PE
//        momentum, volatility-squeeze STRADDLE window) + TradingView alerts
//        so no live-market opportunity is missed
//   5 ✅ Branding — ⭕ CTC logo in panel, labels and tables
//
//  PAPER ONLY — no real orders. Lot sizes indicative (override available).
//  Option premiums come live from TradingView's NSE option contracts; if your
//  TradingView plan shows delayed NSE data, prices will be delayed the same.
// ============================================================================

//@version=6
indicator("⭕ CTC Paper Trade PRO — Option Buying", shorttitle="⭕ CTC PRO", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ----------------------------------------------------------------------------
//  DISPLAY
// ----------------------------------------------------------------------------
g_ui      = "Display"
panelPos  = input.string("Top Right",   "Info panel position",   options=["Top Right","Top Left","Middle Right","Middle Left"], group=g_ui)
optPos    = input.string("Top Left",    "Option engine position", options=["Top Left","Top Right","Middle Left","Middle Right","Bottom Left"], group=g_ui)
jrnPos    = input.string("Bottom Right", "Journal position",      options=["Bottom Right","Bottom Left","Middle Right","Middle Left"], group=g_ui)
txtSize   = input.string("Normal", "Text size", options=["Tiny","Small","Normal","Large"], group=g_ui)
showZones = input.bool(true, "Shade risk / reward zones on chart", group=g_ui)
showJrn   = input.bool(true, "Show the extra-trades journal table", group=g_ui)
showSig   = input.bool(true, "Show signal marks on chart", group=g_ui)

// ----------------------------------------------------------------------------
//  ACTIVE TRADE — click the chart to place (or type the numbers here)
// ----------------------------------------------------------------------------
g_tr      = "Active trade (click on chart in this order)"
entryP    = input.price(0.0, "1) Entry level  (click)",  confirm=true, group=g_tr)
slP       = input.price(0.0, "2) Stop-loss    (click)",  confirm=true, group=g_tr)
tgtP      = input.price(0.0, "3) Target       (click)",  confirm=true, group=g_tr)
entryT    = input.time(timestamp("2026-01-01T09:15:00"), "4) Entry time (click)", confirm=true, group=g_tr)
sideOv    = input.string("Auto", "Side", options=["Auto","Long","Short"], tooltip="Auto = Long if the stop is below entry, Short if the stop is above entry.", group=g_tr)
lotsIn    = input.int(1, "Number of lots", minval=1, group=g_tr)
lotOv     = input.int(0, "Lot size override (0 = auto)", minval=0, tooltip="Leave 0 to auto-fill from the built-in NSE F&O table. Set a value to override when NSE revises the lot or the symbol is not in the table.", group=g_tr)
reason    = input.string("", "Reason / notes for this trade", group=g_tr)

// ----------------------------------------------------------------------------
//  OPTION ENGINE — live premiums by expiry + strike (buy-side focus)
// ----------------------------------------------------------------------------
g_op      = "⭕ Option engine (CE/PE buying, straddle, strangle)"
optOn     = input.bool(false, "Enable option engine", group=g_op)
optExp    = input.time(timestamp("2026-08-27T15:30:00"), "Expiry date", tooltip="Pick the exact listed expiry date of the contract.", group=g_op)
optLots   = input.int(1, "Lots (options)", minval=1, group=g_op)
rf        = input.float(6.5, "Risk-free rate %", minval=0, step=0.25, group=g_op) / 100.0
lg1On     = input.bool(true, "Leg 1 on", group=g_op, inline="L1")
lg1Type   = input.string("CE", "", options=["CE","PE"], group=g_op, inline="L1")
lg1K      = input.float(24500.0, "Strike", minval=0.05, group=g_op, inline="L1")
lg1Entry  = input.float(0.0, "Entry prem (0=watch)", minval=0, group=g_op, inline="L1")
lg2On     = input.bool(false, "Leg 2 on", group=g_op, inline="L2")
lg2Type   = input.string("PE", "", options=["CE","PE"], group=g_op, inline="L2")
lg2K      = input.float(24500.0, "Strike", minval=0.05, group=g_op, inline="L2")
lg2Entry  = input.float(0.0, "Entry prem (0=watch)", minval=0, group=g_op, inline="L2")

// ----------------------------------------------------------------------------
//  OPPORTUNITY SCANNER — buy-side only (CE / PE / straddle window)
// ----------------------------------------------------------------------------
g_sc      = "Opportunity scanner"
emaFastL  = input.int(9,  "Fast EMA", minval=2, group=g_sc)
emaSlowL  = input.int(21, "Slow EMA", minval=3, group=g_sc)
rsiL      = input.int(14, "RSI length", minval=2, group=g_sc)
rsiBull   = input.int(55, "RSI bull level", minval=50, maxval=80, group=g_sc)
rsiBear   = input.int(45, "RSI bear level", minval=20, maxval=50, group=g_sc)
volMult   = input.float(1.5, "Volume surge x avg", minval=0.5, step=0.1, group=g_sc)
sigLook   = input.int(5, "Show signals from last N bars", minval=1, maxval=50, group=g_sc)

// ----------------------------------------------------------------------------
//  DATA SOURCE
// ----------------------------------------------------------------------------
g_src     = "Data source"
useFut    = input.bool(true, "Fetch front-month FUTURES price for info/journal", group=g_src)
exPrefix  = input.string("NSE", "Exchange prefix", options=["NSE","BSE","MCX"], group=g_src)
chgPerLot = input.float(0.0, "Round-trip charges per lot (₹)", minval=0, group=g_src)

// ----------------------------------------------------------------------------
//  BUILT-IN F&O LOT-SIZE TABLE  (indicative — verify vs current NSE circular)
// ----------------------------------------------------------------------------
