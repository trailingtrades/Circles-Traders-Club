        => 0

f_clean(string s) => str.upper(str.replace_all(s, " ", ""))

// ----------------------------------------------------------------------------
//  AUTO CONTEXT — symbol, futures price (info), lot size
// ----------------------------------------------------------------------------
baseSym    = f_clean(str.replace_all(str.replace_all(syminfo.ticker, "1!", ""), "!", ""))
isFutChart = syminfo.type == "futures" or str.contains(syminfo.ticker, "!")

futPrice   = request.security(exPrefix + ":" + baseSym + "1!", timeframe.period, close, ignore_invalid_symbol=true)
futInfo    = (useFut and not isFutChart and not na(futPrice)) ? futPrice : na
chartTag   = isFutChart ? "futures" : "cash"

// The active clicked trade always uses the chart you clicked on, so levels
// and P&L stay on the same price series (no cash-vs-futures mismatch).
curPrice   = close

lotAuto    = f_lot(baseSym)
lotSize    = lotOv > 0 ? lotOv : lotAuto
lotFound   = lotSize > 0

// ----------------------------------------------------------------------------
//  ACTIVE TRADE MATH
// ----------------------------------------------------------------------------
placed   = entryP > 0 and slP > 0
isLong   = sideOv == "Long" ? true : sideOv == "Short" ? false : (slP < entryP)
qty      = lotSize * lotsIn

riskUnit = math.abs(entryP - slP)
rewUnit  = tgtP > 0 ? math.abs(tgtP - entryP) : na
rrPlan   = (not na(rewUnit) and riskUnit > 0) ? rewUnit / riskUnit : na

inTrade  = placed and time >= entryT
var string result  = "RUNNING"
var int    hitTime = na
if placed and inTrade and result == "RUNNING"
    if isLong
        if low <= slP
            result := "STOP HIT"
            hitTime := time
        else if tgtP > 0 and high >= tgtP
            result := "TARGET HIT"
            hitTime := time
    else
        if high >= slP
            result := "STOP HIT"
            hitTime := time
        else if tgtP > 0 and low <= tgtP
            result := "TARGET HIT"
            hitTime := time

closed   = result != "RUNNING"
exitPx   = result == "TARGET HIT" ? tgtP : result == "STOP HIT" ? slP : curPrice
perUnit  = isLong ? (exitPx - entryP) : (entryP - exitPx)
grossPnl = perUnit * qty
charges  = chgPerLot * lotsIn
netPnl   = grossPnl - charges
riskRs   = riskUnit * qty
pnlPct   = entryP > 0 ? netPnl / (entryP * qty) * 100 : na
curR     = riskUnit > 0 ? perUnit / riskUnit : na

endTs    = closed and not na(hitTime) ? hitTime : timenow
daysHeld = placed ? int(math.max(0, math.floor((endTs - entryT) / 86400000))) : 0

// ----------------------------------------------------------------------------
//  GENERAL HELPERS
// ----------------------------------------------------------------------------
f_pos(string p) => p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : p == "Middle Left" ? position.middle_left : position.middle_right
tSize = txtSize == "Tiny" ? size.tiny : txtSize == "Small" ? size.small : txtSize == "Large" ? size.large : size.normal

f_grp(int n) =>
    s = str.tostring(math.abs(n))
    out = ""
    cnt = 0
    for i = str.length(s) - 1 to 0
        out := str.substring(s, i, i + 1) + out
        cnt += 1
        if cnt % 3 == 0 and i != 0
            out := "," + out
    out

f_money(float v) =>
    sign = v < 0 ? "-" : ""
    av   = math.abs(v)
    w    = math.floor(av)
    fr   = math.round((av - w) * 100)
    frF  = fr == 100 ? 0 : fr
    wA   = fr == 100 ? w + 1 : w
    frS  = (frF < 10 ? "0" : "") + str.tostring(frF)
    sign + "₹" + f_grp(int(wA)) + "." + frS

f_pnlCol(float v) => v > 0 ? #26a69a : v < 0 ? #ef5350 : color.gray

// ----------------------------------------------------------------------------
//  BLACK-SCHOLES MATH  (for IV + Greeks of the option legs)
// ----------------------------------------------------------------------------
f_pdf(float x) =>
    math.exp(-x * x / 2.0) / math.sqrt(2.0 * math.pi)

f_cdf(float x) =>
    k = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    poly = k * (0.319381530 + k * (-0.356563782 + k * (1.781477937 + k * (-1.821255978 + k * 1.330274429))))
    w = 1.0 - f_pdf(x) * poly
    x < 0 ? 1.0 - w : w

f_bs(float s, float k, float t, float r, float sig, bool isCall) =>
    d1 = (math.log(s / k) + (r + sig * sig / 2.0) * t) / (sig * math.sqrt(t))
    d2 = d1 - sig * math.sqrt(t)
    isCall ? s * f_cdf(d1) - k * math.exp(-r * t) * f_cdf(d2) : k * math.exp(-r * t) * f_cdf(-d2) - s * f_cdf(-d1)

// Solve implied volatility from the live premium (Newton-Raphson)
f_iv(float mkt, float s, float k, float t, float r, bool isCall) =>
    float ivOut = na
    if mkt > 0 and s > 0 and k > 0 and t > 0
        float sig  = math.max(0.05, math.sqrt(2.0 * math.pi / t) * mkt / s)
        float diff = 1.0e9
        int   it   = 0
        while it < 60 and math.abs(diff) > 0.01
            price = f_bs(s, k, t, r, sig, isCall)
            d1 = (math.log(s / k) + (r + sig * sig / 2.0) * t) / (sig * math.sqrt(t))
            vega = s * f_pdf(d1) * math.sqrt(t)
            diff := price - mkt
            if vega < 0.0001
                break
            sig := sig - diff / vega
            sig := math.min(math.max(sig, 0.01), 5.0)
            it += 1
        if math.abs(diff) <= 0.5
            ivOut := sig
    ivOut

f_greeks(float s, float k, float t, float r, float sig, bool isCall) =>
    d1 = (math.log(s / k) + (r + sig * sig / 2.0) * t) / (sig * math.sqrt(t))
    d2 = d1 - sig * math.sqrt(t)
    delta = isCall ? f_cdf(d1) : f_cdf(d1) - 1.0
    gamma = f_pdf(d1) / (s * sig * math.sqrt(t))
    vega1 = s * f_pdf(d1) * math.sqrt(t) / 100.0
    decay = -(s * f_pdf(d1) * sig) / (2.0 * math.sqrt(t))
    thYr  = isCall ? decay - r * k * math.exp(-r * t) * f_cdf(d2) : decay + r * k * math.exp(-r * t) * f_cdf(-d2)
    [delta, gamma, thYr / 365.0, vega1]

// ----------------------------------------------------------------------------
//  OPTION TICKERS — built from expiry + strike, premiums fetched LIVE
//  Format: NSE:SYMBOL + YYMMDD + C/P + STRIKE   (e.g. NSE:NIFTY260827C24500)
// ----------------------------------------------------------------------------
f_expStr(int t) =>
    str.tostring(year(t) % 100, "00") + str.tostring(month(t), "00") + str.tostring(dayofmonth(t), "00")

f_kStr(float k) => str.tostring(k, "#.##")

lg1Tk  = exPrefix + ":" + baseSym + f_expStr(optExp) + (lg1Type == "CE" ? "C" : "P") + f_kStr(lg1K)
lg2Tk  = exPrefix + ":" + baseSym + f_expStr(optExp) + (lg2Type == "CE" ? "C" : "P") + f_kStr(lg2K)
lg1Ltp = request.security(lg1Tk, timeframe.period, close, ignore_invalid_symbol=true)
lg2Ltp = request.security(lg2Tk, timeframe.period, close, ignore_invalid_symbol=true)

// ----------------------------------------------------------------------------
//  OPPORTUNITY SCANNER  (buy-side: BUY CE, BUY PE, STRADDLE window)
// ----------------------------------------------------------------------------
emaF   = ta.ema(close, emaFastL)
emaS   = ta.ema(close, emaSlowL)
rsiV   = ta.rsi(close, rsiL)
volAvg = ta.sma(volume, 20)
volOk  = na(volAvg) or volAvg <= 0 ? true : volume > volMult * volAvg

buyCE  = ta.crossover(emaF, emaS) and rsiV > rsiBull and volOk
buyPE  = ta.crossunder(emaF, emaS) and rsiV < rsiBear and volOk

// TTM-style volatility squeeze → big move expected → LONG STRADDLE/STRANGLE
bbBase = ta.sma(close, 20)
bbDev  = 2.0 * ta.stdev(close, 20)
kcAtr  = ta.atr(20)
sqzOn  = (bbBase + bbDev) < (bbBase + 1.5 * kcAtr) and (bbBase - bbDev) > (bbBase - 1.5 * kcAtr)
sqzNew = sqzOn and not sqzOn[1]
sqzRel = not sqzOn and sqzOn[1]

ceAgo  = ta.barssince(buyCE)
peAgo  = ta.barssince(buyPE)
relAgo = ta.barssince(sqzRel)

plotshape(showSig and buyCE,  "Buy CE",   style=shape.labelup,   location=location.belowbar, color=color.new(#26a69a, 0), text="CE 🔥", textcolor=color.white, size=size.small)
plotshape(showSig and buyPE,  "Buy PE",   style=shape.labeldown, location=location.abovebar, color=color.new(#ef5350, 0), text="PE 🔥", textcolor=color.white, size=size.small)
plotshape(showSig and sqzRel, "Straddle", style=shape.diamond,   location=location.abovebar, color=color.new(color.orange, 0), text="⚡STRD", textcolor=color.orange, size=size.tiny)

// Alerts — create these once (right-click chart → Add alert → this indicator)
// and TradingView watches the live market for you 24x7. No opportunity missed.
alertcondition(buyCE,  "⭕ CTC: BUY CE opportunity",   "CTC: Bullish momentum on {{ticker}} — CE buying opportunity. Check the chart.")
alertcondition(buyPE,  "⭕ CTC: BUY PE opportunity",   "CTC: Bearish momentum on {{ticker}} — PE buying opportunity. Check the chart.")
alertcondition(sqzNew, "⭕ CTC: Squeeze building",     "CTC: Volatility squeeze building on {{ticker}} — straddle/strangle ready rakho.")
alertcondition(sqzRel, "⭕ CTC: STRADDLE window open", "CTC: Squeeze released on {{ticker}} — big move likely, LONG STRADDLE/STRANGLE window.")
alertcondition(closed and not closed[1], "⭕ CTC: Active trade closed", "CTC: Aapka active paper trade close ho gaya (stop ya target hit) on {{ticker}}.")

// ----------------------------------------------------------------------------
//  JOURNAL — extra typed trades across symbols (auto lot size + futures price)
// ----------------------------------------------------------------------------
g_j  = "Journal — extra trades (type the symbol)"
j1on = input.bool(false, "Enable", group=g_j, inline="j1")
j1s  = input.string("",  "Symbol", group=g_j, inline="j1")
j1d  = input.string("Long", "", options=["Long","Short"], group=g_j, inline="j1")
j1l  = input.int(1, "Lots", minval=1, group=g_j, inline="j1")
j1e  = input.float(0.0, "Entry", group=g_j, inline="j1")

j2on = input.bool(false, "Enable", group=g_j, inline="j2")
j2s  = input.string("",  "Symbol", group=g_j, inline="j2")
j2d  = input.string("Long", "", options=["Long","Short"], group=g_j, inline="j2")
j2l  = input.int(1, "Lots", minval=1, group=g_j, inline="j2")
j2e  = input.float(0.0, "Entry", group=g_j, inline="j2")

j3on = input.bool(false, "Enable", group=g_j, inline="j3")
j3s  = input.string("",  "Symbol", group=g_j, inline="j3")
j3d  = input.string("Long", "", options=["Long","Short"], group=g_j, inline="j3")
j3l  = input.int(1, "Lots", minval=1, group=g_j, inline="j3")
j3e  = input.float(0.0, "Entry", group=g_j, inline="j3")

j4on = input.bool(false, "Enable", group=g_j, inline="j4")
j4s  = input.string("",  "Symbol", group=g_j, inline="j4")
j4d  = input.string("Long", "", options=["Long","Short"], group=g_j, inline="j4")
j4l  = input.int(1, "Lots", minval=1, group=g_j, inline="j4")
j4e  = input.float(0.0, "Entry", group=g_j, inline="j4")

j5on = input.bool(false, "Enable", group=g_j, inline="j5")
j5s  = input.string("",  "Symbol", group=g_j, inline="j5")
j5d  = input.string("Long", "", options=["Long","Short"], group=g_j, inline="j5")
j5l  = input.int(1, "Lots", minval=1, group=g_j, inline="j5")
j5e  = input.float(0.0, "Entry", group=g_j, inline="j5")

j1c = f_clean(j1s)
j2c = f_clean(j2s)
j3c = f_clean(j3s)
j4c = f_clean(j4s)
j5c = f_clean(j5s)
j1p = request.security(exPrefix + ":" + j1c + "1!", timeframe.period, close, ignore_invalid_symbol=true)
j2p = request.security(exPrefix + ":" + j2c + "1!", timeframe.period, close, ignore_invalid_symbol=true)
j3p = request.security(exPrefix + ":" + j3c + "1!", timeframe.period, close, ignore_invalid_symbol=true)
j4p = request.security(exPrefix + ":" + j4c + "1!", timeframe.period, close, ignore_invalid_symbol=true)
j5p = request.security(exPrefix + ":" + j5c + "1!", timeframe.period, close, ignore_invalid_symbol=true)

jOn   = array.from(j1on, j2on, j3on, j4on, j5on)
jSymC = array.from(j1c,  j2c,  j3c,  j4c,  j5c)
jSide = array.from(j1d,  j2d,  j3d,  j4d,  j5d)
jLot  = array.from(j1l,  j2l,  j3l,  j4l,  j5l)
jEnt  = array.from(j1e,  j2e,  j3e,  j4e,  j5e)
jPx   = array.from(j1p,  j2p,  j3p,  j4p,  j5p)

// ----------------------------------------------------------------------------
//  DRAW ACTIVE TRADE ON CHART (last bar only)
// ----------------------------------------------------------------------------
var line  lnE = na
var line  lnS = na
var line  lnT = na
var box   bxR = na
var box   bxP = na
var label lbE = na

if barstate.islast
    for l in array.from(lnE, lnS, lnT)
        line.delete(l)
    box.delete(bxR)
    box.delete(bxP)
    label.delete(lbE)

    if placed
        lnE := line.new(entryT, entryP, timenow, entryP, xloc=xloc.bar_time, color=color.new(color.blue, 0), width=2, extend=extend.right)
        lnS := line.new(entryT, slP, timenow, slP, xloc=xloc.bar_time, color=color.new(#ef5350, 0), width=2, style=line.style_dashed, extend=extend.right)
        if tgtP > 0
            lnT := line.new(entryT, tgtP, timenow, tgtP, xloc=xloc.bar_time, color=color.new(#26a69a, 0), width=2, style=line.style_dashed, extend=extend.right)
        if showZones
            bxR := box.new(entryT, math.max(entryP, slP), timenow, math.min(entryP, slP), xloc=xloc.bar_time, border_width=0, bgcolor=color.new(#ef5350, 85))
            if tgtP > 0
                bxP := box.new(entryT, math.max(entryP, tgtP), timenow, math.min(entryP, tgtP), xloc=xloc.bar_time, border_width=0, bgcolor=color.new(#26a69a, 85))
        lbTxt = "⭕CTC " + (isLong ? "LONG " : "SHORT ") + baseSym + "  " + f_money(netPnl) + (closed ? "  [" + result + "]" : "")
        lbE := label.new(timenow, entryP, lbTxt, xloc=xloc.bar_time, style=label.style_label_left, color=f_pnlCol(netPnl), textcolor=color.white, size=tSize)

// ----------------------------------------------------------------------------
//  INFO PANEL (last bar only)
// ----------------------------------------------------------------------------
var table pnl = table.new(f_pos(panelPos), 2, 24, border_width=1, frame_width=1, frame_color=color.new(color.gray, 50))

f_row(int r, string k, string v, color vc) =>
    table.cell(pnl, 0, r, k, text_color=color.new(color.gray, 0), bgcolor=color.new(color.black, 15), text_size=tSize, text_halign=text.align_left)
    table.cell(pnl, 1, r, v, text_color=vc, bgcolor=color.new(color.black, 15), text_size=tSize, text_halign=text.align_right)

f_hdr(int r, string txtL) =>
    table.cell(pnl, 0, r, txtL, text_color=color.white, bgcolor=color.new(color.orange, 20), text_size=tSize, text_halign=text.align_left)
    table.cell(pnl, 1, r, "", bgcolor=color.new(color.orange, 20), text_size=tSize)

if barstate.islast
    table.clear(pnl, 0, 0, 1, 23)
    table.cell(pnl, 0, 0, "⭕ CIRCLES TRADERS CLUB", text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=tSize, text_halign=text.align_left)
    table.cell(pnl, 1, 0, "PAPER PRO", text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=tSize, text_halign=text.align_right)

    ceTxt = na(ceAgo) ? "—" : ceAgo == 0 ? "NOW 🔥🔥" : ceAgo <= sigLook ? str.tostring(ceAgo) + " bars ago 🔥" : "—"
    peTxt = na(peAgo) ? "—" : peAgo == 0 ? "NOW 🔥🔥" : peAgo <= sigLook ? str.tostring(peAgo) + " bars ago 🔥" : "—"
    sqTxt = sqzOn ? "SQUEEZE ON ⚡ get ready" : na(relAgo) ? "—" : relAgo == 0 ? "RELEASED NOW 🔥" : relAgo <= sigLook ? "released " + str.tostring(relAgo) + " bars ago" : "—"
    ceCol = ceTxt == "—" ? color.gray : #26a69a
    peCol = peTxt == "—" ? color.gray : #ef5350
    sqCol = sqTxt == "—" ? color.gray : color.orange

    if not placed
        f_row(1, "Symbol", baseSym + " (" + chartTag + ")", color.white)
        f_row(2, "Lot size", lotFound ? str.tostring(lotSize) + (lotOv > 0 ? " (manual)" : " (auto)") : "not found ⚠", lotFound ? color.white : color.orange)
        f_row(3, "LTP", str.tostring(curPrice, format.mintick), color.white)
        f_row(4, "Front-month fut", na(futInfo) ? "—" : str.tostring(futInfo, format.mintick), color.silver)
        f_row(5, "How to place", "Click Entry, then Stop,", color.aqua)
        f_row(6, "", "then Target, then entry time", color.aqua)
        f_hdr(7, "⭕ OPPORTUNITY SCANNER")
        f_row(8,  "Buy CE (momentum)", ceTxt, ceCol)
        f_row(9,  "Buy PE (momentum)", peTxt, peCol)
        f_row(10, "Straddle window", sqTxt, sqCol)
        f_row(11, "Never miss a move", "Set alerts on this indicator", color.aqua)
    else
        f_row(1,  "Symbol", baseSym + " (" + chartTag + ")", color.white)
        f_row(2,  "Side", isLong ? "LONG" : "SHORT", isLong ? #26a69a : #ef5350)
        f_row(3,  "Lot size", str.tostring(lotSize) + (lotOv > 0 ? " (manual)" : lotFound ? " (auto)" : " ⚠"), lotFound ? color.white : color.orange)
        f_row(4,  "Lots x size = Qty", str.tostring(lotsIn) + " x " + str.tostring(lotSize) + " = " + str.tostring(qty), color.white)
        f_row(5,  "Entry", str.tostring(entryP, format.mintick), color.white)
        f_row(6,  "LTP", str.tostring(curPrice, format.mintick), color.white)
        f_row(7,  "Front-month fut", na(futInfo) ? "—" : str.tostring(futInfo, format.mintick), color.silver)
        f_row(8,  "Stop-loss", str.tostring(slP, format.mintick), #ef5350)
        f_row(9,  "Target", tgtP > 0 ? str.tostring(tgtP, format.mintick) : "—", #26a69a)
        f_row(10, "Risk / unit", str.tostring(riskUnit, format.mintick), color.white)
        f_row(11, "Planned R:R", na(rrPlan) ? "—" : "1 : " + str.tostring(rrPlan, "#.##"), color.white)
        f_row(12, "Live R-multiple", na(curR) ? "—" : str.tostring(curR, "#.##") + "R", f_pnlCol(curR))
        f_row(13, "Risk amount", f_money(riskRs), #ef5350)
        f_row(14, closed ? "P&L (final)" : "P&L (live)", f_money(netPnl), f_pnlCol(netPnl))
        f_row(15, "P&L %", na(pnlPct) ? "—" : str.tostring(pnlPct, "#.##") + "%", f_pnlCol(netPnl))
        f_row(16, "Days held", str.tostring(daysHeld), color.white)
        f_row(17, "Status", closed ? result : "RUNNING", closed ? (result == "TARGET HIT" ? #26a69a : #ef5350) : color.aqua)
        f_row(18, "Reason", reason == "" ? "—" : reason, color.silver)
        f_hdr(19, "⭕ OPPORTUNITY SCANNER")
        f_row(20, "Buy CE (momentum)", ceTxt, ceCol)
        f_row(21, "Buy PE (momentum)", peTxt, peCol)
        f_row(22, "Straddle window", sqTxt, sqCol)

// ----------------------------------------------------------------------------
//  ⭕ OPTION ENGINE TABLE (last bar only) — live premiums + IV + Greeks
// ----------------------------------------------------------------------------
var table ot = table.new(f_pos(optPos), 4, 15, border_width=1, frame_width=1, frame_color=color.new(color.gray, 50))

f_orow(int r, string lbl, string v1, string v2, string vn, color c1, color c2, color cn) =>
    bgc = color.new(color.black, 15)
    table.cell(ot, 0, r, lbl, text_color=color.new(color.gray, 0), bgcolor=bgc, text_size=tSize, text_halign=text.align_left)
    table.cell(ot, 1, r, v1, text_color=c1, bgcolor=bgc, text_size=tSize, text_halign=text.align_right)
    table.cell(ot, 2, r, v2, text_color=c2, bgcolor=bgc, text_size=tSize, text_halign=text.align_right)
    table.cell(ot, 3, r, vn, text_color=cn, bgcolor=bgc, text_size=tSize, text_halign=text.align_right)

if barstate.islast and optOn
    table.clear(ot, 0, 0, 3, 14)
    hb = color.new(color.purple, 0)
    table.cell(ot, 0, 0, "⭕ CTC OPTION ENGINE", text_color=color.white, bgcolor=hb, text_size=tSize, text_halign=text.align_left)
    table.cell(ot, 1, 0, "Leg 1", text_color=color.white, bgcolor=hb, text_size=tSize, text_halign=text.align_right)
    table.cell(ot, 2, 0, "Leg 2", text_color=color.white, bgcolor=hb, text_size=tSize, text_halign=text.align_right)
    table.cell(ot, 3, 0, "NET",   text_color=color.white, bgcolor=hb, text_size=tSize, text_halign=text.align_right)

    spotS = close
    tYr   = math.max((optExp - timenow) / 31536000000.0, 0.0)
    dte   = (optExp - timenow) / 86400000.0

    has1  = lg1On and not na(lg1Ltp) and lg1Ltp > 0
    has2  = lg2On and not na(lg2Ltp) and lg2Ltp > 0

    ivPx1 = has1 ? lg1Ltp : lg1Entry
    ivPx2 = has2 ? lg2Ltp : lg2Entry
    iv1   = lg1On ? f_iv(ivPx1, spotS, lg1K, tYr, rf, lg1Type == "CE") : na
    iv2   = lg2On ? f_iv(ivPx2, spotS, lg2K, tYr, rf, lg2Type == "CE") : na

    float dl1 = na
    float gm1 = na
    float th1 = na
    float vg1 = na
    if not na(iv1)
        [a1, b1, c1, e1] = f_greeks(spotS, lg1K, tYr, rf, iv1, lg1Type == "CE")
        dl1 := a1
        gm1 := b1
        th1 := c1
        vg1 := e1
    float dl2 = na
    float gm2 = na
    float th2 = na
    float vg2 = na
    if not na(iv2)
        [a2, b2, c2x, e2] = f_greeks(spotS, lg2K, tYr, rf, iv2, lg2Type == "CE")
        dl2 := a2
        gm2 := b2
        th2 := c2x
        vg2 := e2

    oq    = lotSize * optLots
    pnl1  = lg1On and lg1Entry > 0 and has1 ? (lg1Ltp - lg1Entry) * oq : na
    pnl2  = lg2On and lg2Entry > 0 and has2 ? (lg2Ltp - lg2Entry) * oq : na
    pct1  = not na(pnl1) ? (lg1Ltp - lg1Entry) / lg1Entry * 100 : na
    pct2  = not na(pnl2) ? (lg2Ltp - lg2Entry) / lg2Entry * 100 : na
    netP  = (na(pnl1) and na(pnl2)) ? na : nz(pnl1) + nz(pnl2)

    prem1 = lg1On ? (lg1Entry > 0 ? lg1Entry : has1 ? lg1Ltp : na) : na
    prem2 = lg2On ? (lg2Entry > 0 ? lg2Entry : has2 ? lg2Ltp : na) : na
    totPr = nz(prem1) + nz(prem2)
    be1   = not na(prem1) ? (lg1Type == "CE" ? lg1K + prem1 : lg1K - prem1) : na
    be2   = not na(prem2) ? (lg2Type == "CE" ? lg2K + prem2 : lg2K - prem2) : na

    bothL = lg1On and lg2On
    mixed = bothL and lg1Type != lg2Type
    strat = bothL ? (mixed ? (lg1K == lg2K ? "LONG STRADDLE" : "LONG STRANGLE") : "2x LONG " + lg1Type) : lg1On ? "LONG " + lg1Type : lg2On ? "LONG " + lg2Type : "—"
    ceK2  = lg1Type == "CE" ? lg1K : lg2K
    peK2  = lg1Type == "PE" ? lg1K : lg2K
    beNet = mixed and totPr > 0 ? str.tostring(peK2 - totPr, format.mintick) + " / " + str.tostring(ceK2 + totPr, format.mintick) : "—"

    s1 = lg1On ? lg1Type + " " + f_kStr(lg1K) : "—"
    s2 = lg2On ? lg2Type + " " + f_kStr(lg2K) : "—"
    f_orow(1, "Contract", s1, s2, strat, color.white, color.white, color.aqua)
    f_orow(2, "LTP (live)", lg1On ? (has1 ? str.tostring(lg1Ltp, format.mintick) : "no data ⚠") : "—", lg2On ? (has2 ? str.tostring(lg2Ltp, format.mintick) : "no data ⚠") : "—", totPr > 0 ? str.tostring(totPr, format.mintick) : "—", has1 ? color.white : color.orange, has2 ? color.white : color.orange, color.white)
    f_orow(3, "Entry premium", lg1On and lg1Entry > 0 ? str.tostring(lg1Entry, format.mintick) : "—", lg2On and lg2Entry > 0 ? str.tostring(lg2Entry, format.mintick) : "—", "", color.white, color.white, color.white)
    f_orow(4, "P&L ₹ (" + str.tostring(optLots) + "x" + str.tostring(lotSize) + ")", na(pnl1) ? "—" : f_money(pnl1), na(pnl2) ? "—" : f_money(pnl2), na(netP) ? "—" : f_money(netP), f_pnlCol(nz(pnl1)), f_pnlCol(nz(pnl2)), f_pnlCol(nz(netP)))
    f_orow(5, "P&L %", na(pct1) ? "—" : str.tostring(pct1, "#.##") + "%", na(pct2) ? "—" : str.tostring(pct2, "#.##") + "%", "", f_pnlCol(nz(pnl1)), f_pnlCol(nz(pnl2)), color.white)
    f_orow(6, "IV %", na(iv1) ? "—" : str.tostring(iv1 * 100, "#.#") + "%", na(iv2) ? "—" : str.tostring(iv2 * 100, "#.#") + "%", "", color.yellow, color.yellow, color.white)
    f_orow(7, "Delta", na(dl1) ? "—" : str.tostring(dl1, "#.###"), na(dl2) ? "—" : str.tostring(dl2, "#.###"), (na(dl1) and na(dl2)) ? "—" : str.tostring(nz(dl1) + nz(dl2), "#.###"), color.white, color.white, color.aqua)
    f_orow(8, "Gamma", na(gm1) ? "—" : str.tostring(gm1, "#.####"), na(gm2) ? "—" : str.tostring(gm2, "#.####"), "", color.white, color.white, color.white)
    f_orow(9, "Theta ₹/day (pos)", na(th1) ? "—" : f_money(th1 * oq), na(th2) ? "—" : f_money(th2 * oq), (na(th1) and na(th2)) ? "—" : f_money((nz(th1) + nz(th2)) * oq), #ef5350, #ef5350, #ef5350)
    f_orow(10, "Vega ₹/1% (pos)", na(vg1) ? "—" : f_money(vg1 * oq), na(vg2) ? "—" : f_money(vg2 * oq), (na(vg1) and na(vg2)) ? "—" : f_money((nz(vg1) + nz(vg2)) * oq), color.white, color.white, color.white)
    f_orow(11, "Breakeven", na(be1) ? "—" : str.tostring(be1, format.mintick), na(be2) ? "—" : str.tostring(be2, format.mintick), beNet, color.white, color.white, color.aqua)
    f_orow(12, "Days to expiry", dte <= 0 ? "EXPIRED ⚠" : str.tostring(dte, "#.#"), "", "", dte <= 0 ? color.orange : color.white, color.white, color.white)
    f_orow(13, "Ticker", lg1On ? lg1Tk : "—", lg2On ? lg2Tk : "—", "", color.silver, color.silver, color.white)
    f_orow(14, "Total premium ₹", "", "", totPr > 0 ? f_money(totPr * oq) : "—", color.white, color.white, color.yellow)

// ----------------------------------------------------------------------------
//  JOURNAL TABLE (last bar only)
// ----------------------------------------------------------------------------
var table jt = table.new(f_pos(jrnPos), 7, 8, border_width=1, frame_width=1, frame_color=color.new(color.gray, 50))

if barstate.islast and showJrn
    table.clear(jt, 0, 0, 6, 7)
    jh = array.from("⭕ Symbol", "Side", "Qty", "Entry", "LTP", "P&L ₹", "P&L %")
    for c = 0 to 6
        table.cell(jt, c, 0, array.get(jh, c), text_color=color.white, bgcolor=color.new(color.purple, 0), text_size=tSize, text_halign=text.align_left)

    float jNet = 0.0
    int   jRow = 0
    for i = 0 to array.size(jOn) - 1
        sym = array.get(jSymC, i)
        if array.get(jOn, i) and sym != "" and array.get(jEnt, i) > 0
            jLong = array.get(jSide, i) == "Long"
            jls   = f_lot(sym)
            jq    = jls * array.get(jLot, i)
            jpx   = array.get(jPx, i)
            has   = not na(jpx)
            jent  = array.get(jEnt, i)
            jper  = jLong ? (jpx - jent) : (jent - jpx)
            jpnl  = has ? jper * jq : na
            jpct  = has and jent > 0 and jq > 0 ? jpnl / (jent * jq) * 100 : na
            if has
                jNet += jpnl
            jRow += 1
            bg = jRow % 2 == 0 ? color.new(color.gray, 88) : color.new(color.gray, 82)
            table.cell(jt, 0, jRow, sym + (jls > 0 ? "" : " ⚠"), text_color=color.white, bgcolor=bg, text_size=tSize, text_halign=text.align_left)
            table.cell(jt, 1, jRow, jLong ? "LONG" : "SHORT", text_color=jLong ? #26a69a : #ef5350, bgcolor=bg, text_size=tSize)
            table.cell(jt, 2, jRow, str.tostring(array.get(jLot, i)) + "x" + str.tostring(jls) + "=" + str.tostring(jq), text_color=color.white, bgcolor=bg, text_size=tSize)
            table.cell(jt, 3, jRow, str.tostring(jent), text_color=color.white, bgcolor=bg, text_size=tSize)
            table.cell(jt, 4, jRow, has ? str.tostring(jpx, format.mintick) : "n/a", text_color=has ? color.white : color.orange, bgcolor=bg, text_size=tSize)
            table.cell(jt, 5, jRow, has ? f_money(jpnl) : "—", text_color=f_pnlCol(jpnl), bgcolor=bg, text_size=tSize)
            table.cell(jt, 6, jRow, na(jpct) ? "—" : str.tostring(jpct, "#.##") + "%", text_color=f_pnlCol(jpnl), bgcolor=bg, text_size=tSize)

    bookNet = jNet + (placed ? netPnl : 0.0)
    tr = jRow + 1
    table.cell(jt, 0, tr, "BOOK NET (incl. active)", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=tSize, text_halign=text.align_left)
    table.cell(jt, 1, tr, "", bgcolor=color.new(color.black, 0), text_size=tSize)
    table.cell(jt, 2, tr, "", bgcolor=color.new(color.black, 0), text_size=tSize)
    table.cell(jt, 3, tr, "", bgcolor=color.new(color.black, 0), text_size=tSize)
    table.cell(jt, 4, tr, "", bgcolor=color.new(color.black, 0), text_size=tSize)
    table.cell(jt, 5, tr, f_money(bookNet), text_color=f_pnlCol(bookNet), bgcolor=color.new(color.black, 0), text_size=tSize)
    table.cell(jt, 6, tr, "", bgcolor=color.new(color.black, 0), text_size=tSize)
